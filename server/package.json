{
  "name": "@tinker/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "backup:drill": "tsx --env-file-if-exists=.env scripts/backup-drill.ts drill",
    "backup:drill:supabase": "tsx --env-file=.env.supabase.local scripts/backup-drill.ts drill",
    "backup:export": "tsx --env-file-if-exists=.env scripts/backup-drill.ts export",
    "backup:restore": "tsx scripts/backup-drill.ts restore",
    "check:production": "tsx scripts/check-production-mode.ts",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "bench:api": "tsx scripts/bench-api.ts",
    "log:report": "tsx scripts/log-report.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "worker:supabase": "tsx --env-file=.env.supabase.local src/worker.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:api:supabase": "tsx watch --env-file=.env.supabase.local src/main.ts",
    "check:supabase": "tsx --env-file-if-exists=.env.supabase.local scripts/check-supabase.ts",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate -m migrations up",
    "db:migrate:down": "node-pg-migrate -m migrations down",
    "db:migrate:create": "node-pg-migrate -m migrations create",
    "check:gemini": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/check-gemini.ts",
    "check:voice": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/check-voice.ts",
    "check:voice:api": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/check-voice-api.ts",
    "probe:live": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/probe-live.ts",
    "diagnose:gemini": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase.local scripts/diagnose-gemini.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.3.3",
    "@tinker/shared": "*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "ws": "^8.22.0"
  }
}
