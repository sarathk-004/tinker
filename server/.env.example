# Copy to server/.env (gitignored). Server-only; never prefix with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Comma-separated exact origins (no wildcard). Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Needed for db:migrate (and from I3 the API). Matches docker-compose.yml.
DATABASE_URL=postgres://tinker:tinker@localhost:54329/tinker
# Local login without a Supabase project: tokens are signed by a throwaway in-memory key via POST /dev/auth/login.
# Explicit opt-in, honoured only when NODE_ENV=development. Production uses SUPABASE_URL instead.
AUTH_MODE=dev
# SUPABASE_URL=https://<project-ref>.supabase.co
# JWT_AUDIENCE=authenticated
# RATE_LIMIT_PER_MINUTE=120
# AI commands (server-side only; never prefix with VITE_). Without a key the AI path answers 503 and manual editing keeps working.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low   # off | minimal | low | medium | high
# AI_DEADLINE_MS=15000
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_MAX_CONCURRENT=2
# GEMINI_LIVE_MODEL=gemini-3.8-live   # voice (needs GEMINI_API_KEY)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts   # spoken replies, tried in order
# GEMINI_TTS_VOICE=Kore
# VOICE_MAX_SESSIONS=20
# VOICE_MAX_SESSION_MS=600000
