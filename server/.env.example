# Copy to server/.env (gitignored). Server-only; never prefix with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Comma-separated exact origins (no wildcard). Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Needed for db:migrate (and from I3 the API). Matches docker-compose.yml.
DATABASE_URL=postgres://tinker:tinker@localhost:54329/tinker
