{
  "name": "tinker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev -w @tinker/server",
    "check:supabase": "npm run check:supabase -w @tinker/server",
    "build": "tsc -b && vite build && node scripts/write-headers.mjs",
    "preview": "vite preview",
    "preview:headers": "node scripts/preview-with-headers.mjs",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check": "npm run typecheck && npm run test && npm run check:boundaries",
    "test:web": "vitest run",
    "check:gemini": "npm run check:gemini -w @tinker/server",
    "dev:api:local": "npm run dev:api:local -w @tinker/server"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tinker/shared": "*",
    "@xyflow/react": "^12.3.6",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
