# Copy to `.env` in the repository root (git-ignored). This is the ONE settings file: the web app (Vite) reads only the VITE_* lines,
# the API and its scripts read the rest. Never put a secret on a VITE_* line: those ship inside the web app.

# =====================================================================================================================
# Browser (public by design)
# =====================================================================================================================
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) is public by design. NEVER use the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# VITE_API_URL=http://localhost:8787
# VITE_ENABLE_DEV_LOGIN=false
# Optional bot check on the sign-in forms (Cloudflare Turnstile SITE key; the secret key goes only into the Supabase dashboard).
# VITE_TURNSTILE_SITE_KEY=

# =====================================================================================================================
# API and scripts (SECRETS below this line)
# =====================================================================================================================
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Comma-separated exact origins (no wildcard). Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Needed for db:migrate (and from I3 the API). Matches docker-compose.yml.
DATABASE_URL=postgres://tinker:tinker@localhost:54329/tinker
# Local login without a Supabase project: tokens are signed by a throwaway in-memory key via POST /dev/auth/login.
# Explicit opt-in, honoured only when NODE_ENV=development. Production uses SUPABASE_URL instead.
AUTH_MODE=dev
# SUPABASE_URL=https://<project-ref>.supabase.co
# JWT_AUDIENCE=authenticated
# RATE_LIMIT_PER_MINUTE=120
# AI commands (server-side only; never prefix with VITE_). Without a key the AI path answers 503 and manual editing keeps working.
# GEMINI_API_KEY=
# --- Whose model key the AI runs on -------------------------------------------------------------
# server (default in development): the GEMINI_API_KEY below serves everyone.
# user (OFF by decision: people never paste keys into the app): every person adds their own key in the app; nothing runs on yours.
# user_or_server: their own key when they have one, otherwise yours.
# AI_KEY_MODE=server   (the default: the operator key in GEMINI_API_KEY runs the AI)
# Needed unless AI_KEY_MODE=server: seals people's stored keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Host secret store only; never commit it. Rotate with: npm run rotate:ai-keys -w @tinker/server
# KEY_ENCRYPTION_SECRET=
# KEY_ENCRYPTION_SECRET_PREVIOUS=      # retired secret(s), comma separated, while rotating
# REQUIRE_VERIFIED_EMAIL=true          # refuse tokens whose email address was never confirmed
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low   # off | minimal | low | medium | high
# AI_DEADLINE_MS=15000
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_MAX_CONCURRENT=2
# GEMINI_LIVE_MODEL=gemini-3.8-live   # voice (needs GEMINI_API_KEY)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts   # spoken replies, tried in order
# GEMINI_TTS_VOICE=Kore
# WORKER_POLL_MS=5000          # background worker (npm run worker)
# WORKER_LEASE_SECONDS=60
# VOICE_MAX_SESSIONS=20
# VOICE_MAX_SESSION_MS=600000
