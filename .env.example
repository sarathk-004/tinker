# Browser-visible settings (copy to .env). Everything here is PUBLIC and ships in the bundle: never put a secret in a VITE_* variable.
# Gemini and every other provider secret live ONLY in server/.env (server-side).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) is public by design. NEVER use the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# VITE_API_URL=http://localhost:8787
# VITE_ENABLE_DEV_LOGIN=false
