# Cloudflare Pages (and Netlify) security headers for the static frontend. Applied to every path.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(self), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Hashed build assets never change: cache them hard. index.html must always be revalidated so a new release is picked up.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
